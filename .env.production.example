# ---- Copy to .env, fill in, then: docker compose up -d --build ----
# Going from free to paid later = change the keys below and run: docker compose up -d

# Your domains (DNS A records -> this server)
APP_DOMAIN=app.example.in          # owner dashboard
API_DOMAIN=api.example.in          # API, customer pages, widget, webhooks, live calls
ACME_EMAIL=you@example.in          # for HTTPS certificates

# Secrets (generate with: python3 -c "import secrets; print(secrets.token_urlsafe(48))")
SECRET_KEY=
POSTGRES_PASSWORD=

# LLM: Gemini (free or paid key - same variable)
LLM_PROVIDER=gemini
GEMINI_API_KEY=
# LLM_MODEL=                       # pin a model on a paid plan, e.g. gemini-3-flash-preview
# LLM_REASONING=low

# Gnani speech
GNANI_API_KEY=
# GNANI_TTS_VOICE=Shivani

# WhatsApp Cloud API (optional until you connect it)
WHATSAPP_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_TEMPLATE_NAME=            # approved utility template "Update from {{1}}: {{2}}"
WHATSAPP_TEMPLATE_LANG=en

# Exotel phone calls: secret that goes in the Voicebot URL (...&token=THIS). Calls are refused without it.
EXOTEL_WS_TOKEN=

# Razorpay (customer UPI links and your plan payments)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Business rules
TRIAL_DAYS=14
ENFORCE_BILLING=0                  # 1 = stop answering for businesses whose plan lapsed
RETENTION_DAYS=180                 # delete transcripts older than this
DAILY_SUMMARY_HOUR=21
