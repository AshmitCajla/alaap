# --- LLM (free): get a key at https://aistudio.google.com/apikey ---
LLM_PROVIDER=gemini
GEMINI_API_KEY =
# LLM_MODEL=                        # default tries gemini-flash-lite-latest, then 3.1 Flash-Lite, then 3 Flash
# LLM_REASONING=low                  # Gemini thinking: none | low | medium (lower = faster calls)
# Alternatives: LLM_PROVIDER=groq + GROQ_API_KEY=..., or LLM_PROVIDER=ollama (local, no key)

# --- Gnani speech (your hackathon key) ---
GNANI_API_KEY=
# GNANI_TTS_VOICE=Shivani            # timbre-v3.0 voices: Shivani, Avinash, Lakshmi, ...

# --- Storage (defaults: SQLite file + in-memory state) ---
# DATABASE_URL=postgresql+psycopg://alaap:alaap@localhost:5432/alaap
# REDIS_URL=redis://localhost:6379/0

# --- URLs and secrets ---
PUBLIC_URL=http://localhost:8000
DASHBOARD_URL=http://localhost:3000
SECRET_KEY=change-me-to-a-long-random-string-at-least-32-chars

# --- Optional channels (leave blank to keep messages in the dashboard outbox) ---
WHATSAPP_TOKEN=
WHATSAPP_VERIFY_TOKEN=alaap-verify
WHATSAPP_APP_SECRET=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
